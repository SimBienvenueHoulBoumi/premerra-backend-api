#!/usr/bin/env bash
# Vérifie que chaque branche poussée respecte la hiérarchie définie dans CONTRIBUTING.md,
# et que main/develop ne sont jamais poussées : elles n'évoluent que par Pull Request.
# Lance ensuite build + tests (scripts/check.sh) si les commits poussés touchent le code.
pattern='^((feature|fix|refactor|chore|docs|test|hotfix)/[a-z0-9._-]+|release/[0-9]+\.[0-9]+\.[0-9]+)$'
zero=0000000000000000000000000000000000000000
remote=$1
status=0
changed=""
run_all=0

while read -r _ local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  branch=${remote_ref#refs/heads/}

  case "$branch" in
    main|develop)
      # Seule exception : la création initiale de la branche sur le remote
      [ "$remote_sha" = "$zero" ] && continue
      echo "✖ Push direct interdit sur '$branch' : passer par une Pull Request." >&2
      status=1
      continue ;;
  esac

  if ! printf '%s' "$branch" | grep -qE "$pattern"; then
    echo "✖ Nom de branche invalide : '$branch'" >&2
    status=1
  fi

  # Fichiers modifiés par ce push : depuis l'état distant, ou depuis develop pour une nouvelle branche
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ]; then
    base=$remote_sha
  else
    base=$(git merge-base "$local_sha" "refs/remotes/$remote/develop" 2>/dev/null) || { run_all=1; continue; }
  fi
  # Base inconnue en local (remote avancé entre-temps) : on teste tout plutôt que rien
  if files=$(git diff --name-only "$base" "$local_sha" 2>/dev/null); then
    changed="$changed$files
"
  else
    run_all=1
  fi
done

if [ $status -ne 0 ]; then
  cat >&2 <<MSG

main et develop : lecture seule (git pull), modifiées uniquement par Pull Request.
Branches à pousser :
    feature|fix|refactor|chore|docs|test|hotfix/<nom-en-kebab-case>
    release/<X.Y.Z>
Voir CONTRIBUTING.md
MSG
  exit $status
fi

# Build + tests. Contournable : git push --no-verify (la CI relance tout)
[ -z "$(git status --porcelain --untracked-files=no)" ] \
  || echo "⚠ Modifications non commitées : les tests portent sur le dossier de travail." >&2
if [ $run_all -eq 1 ]; then
  ./scripts/check.sh
else
  printf '%s' "$changed" | ./scripts/check.sh --if-changed
fi || { echo "✖ Tests en échec : push annulé." >&2; exit 1; }
