#!/usr/bin/env bash
# Vérifie que chaque branche poussée respecte la hiérarchie définie dans CONTRIBUTING.md,
# et que main/develop ne sont jamais poussées : elles n'évoluent que par Pull Request.
pattern='^((feature|fix|refactor|chore|docs|test|hotfix)/[a-z0-9._-]+|release/[0-9]+\.[0-9]+\.[0-9]+)$'
zero=0000000000000000000000000000000000000000
status=0

while read -r _ _ remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  branch=${remote_ref#refs/heads/}

  case "$branch" in
    main|develop)
      # Seule exception : la création initiale de la branche sur le remote
      [ "$remote_sha" = "$zero" ] && continue
      echo "✖ Push direct interdit sur '$branch' : passer par une Pull Request." >&2
      status=1
      continue ;;
  esac

  if ! printf '%s' "$branch" | grep -qE "$pattern"; then
    echo "✖ Nom de branche invalide : '$branch'" >&2
    status=1
  fi
done

if [ $status -ne 0 ]; then
  cat >&2 <<MSG

main et develop : lecture seule (git pull), modifiées uniquement par Pull Request.
Branches à pousser :
    feature|fix|refactor|chore|docs|test|hotfix/<nom-en-kebab-case>
    release/<X.Y.Z>
Voir CONTRIBUTING.md
MSG
fi
exit $status
