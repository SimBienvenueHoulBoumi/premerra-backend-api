#!/usr/bin/env bash
# Interdit les commits directs sur main : passer par develop, release/* ou hotfix/*.
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# Premier commit du dépôt : main doit exister avant de pouvoir créer develop
git rev-parse --verify -q HEAD >/dev/null || exit 0

if [ "$branch" = "main" ]; then
  cat >&2 <<MSG
✖ Commit direct interdit sur 'main'.
  Crée une branche depuis develop :  git switch develop && git switch -c feature/<nom>
  ou un correctif urgent depuis main : git switch -c hotfix/<nom>
MSG
  exit 1
fi

# Build et tests (commande définie dans scripts/check.sh). Contournable : git commit --no-verify
if ! ./scripts/check.sh --staged; then
  echo "✖ Tests en échec : commit annulé." >&2
  exit 1
fi
